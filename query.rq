PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX fx:   <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:  <http://sparql.xyz/facade-x/data/>
PREFIX ex:   <http://example.org/music/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
    # Define Classes
    ex:Track a rdfs:Class .
    ex:Artist a rdfs:Class .  
    ex:Composer a rdfs:Class .
    ex:Writer a rdfs:Class .
    ex:Lyricist a rdfs:Class .
    ex:Publisher a rdfs:Class .
    ex:Gender a rdfs:Class .
    ex:Language a rdfs:Class .

    # Define Object Properties
    ex:hasComposer a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Composer .    
    ex:hasWriter a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Writer .
    ex:hasArtist a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Artist .
    ex:hasLyricist a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Lyricist .
    ex:hasPublisher a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Publisher .
    ex:hasLanguage a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Language .
    ex:hasGender a rdf:Property ; rdfs:domain ex:Artist ; rdfs:range ex:Gender .
    ex:hasLegalName a rdf:Property ; rdfs:domain ex:Artist ; rdfs:range xsd:string .

    # Generate Instances
    ?trackUri a ex:Track ;
        ex:hasComposer ?composerUri ;
        ex:hasWriter ?writerUri ;
        ex:hasLyricist ?lyricistUri ;
        ex:hasPublisher ?publisherUri ;
        ex:hasArtist ?artistUri ;
        ex:hasLanguage ?languageUri .
    
    ?artistUri a ex:Artist ;
        ex:hasGender ?genderUri ;
        ex:hasLegalName ?legalName .

    ?composerUri a ex:Composer .
    ?writerUri a ex:Writer .
    ?lyricistUri a ex:Lyricist .
    ?publisherUri a ex:Publisher .
    ?languageUri a ex:Language .
    ?genderUri a ex:Gender .
}
WHERE {
  SERVICE <x-sparql-anything:> {
    fx:properties fx:location "new_filtered.json" .

    ?root a fx:root ;
          ?entrySlot ?trackEntry .

    ?trackEntry xyz:track ?track ;
          xyz:language ?languageValue ;
          xyz:composer ?composerList ;
          xyz:publishing ?publisherList ;
          xyz:lyricist ?lyricistList ;
          xyz:writer ?writerList ;
          xyz:artist ?artistList .

    ?artistList ?aIndex ?artistDict .
    FILTER(STRSTARTS(STR(?aIndex), STR(rdf:_)))

    # Extract artistDict
    ?artistDict xyz:artist_name ?artistName ;
                xyz:gender ?gender ;
                xyz:legal_name ?legalNameList .

    # Track and language
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?track, " ", ""))) AS ?trackUri)
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?language, " ", ""))) AS ?languageUri)

    # Publisher list
    ?publisherList ?pIndex ?publisher .
    FILTER(STRSTARTS(STR(?pIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?publisher, " ", ""))) AS ?publisherUri)

    # composer list
    ?composerList ?eIndex ?composer .
    FILTER(STRSTARTS(STR(?eIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?composer, " ", ""))) AS ?composerUri)

    # writer list
    ?writerList ?mIndex ?writer .
    FILTER(STRSTARTS(STR(?mIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?writer, " ", ""))) AS ?writerUri)

    # lyricist list
    ?lyricistList ?tIndex ?lyricist .
    FILTER(STRSTARTS(STR(?tIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?lyricist, " ", ""))) AS ?lyricistUri)

    # Artist name and gender
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?artistName, " ", ""))) AS ?artistUri)
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?gender, " ", ""))) AS ?genderUri)

    # Legal name list
    ?legalNameList ?lnIndex ?legalName .
    FILTER(STRSTARTS(STR(?lnIndex), STR(rdf:_)))
  }
}