mo:track_glorious_macklemore_ft_skylar_grey_8c028f a mo:Track ;
    rdfs:label "Glorious"@en ;
    ex:hasChartRun ex:chartRun_run_glorious_macklemore_ft_skylar_grey_8c028f_2017-10-14 ;
    mo:hasLanguage mo:language_en ;
    mo:hasLyrics """You know I'm back, like I never left (I never left)
Another sprint, another step (Another step)
