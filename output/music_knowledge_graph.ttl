mo:track_farmers_daughter_rodney_atkins_b64f66 a mo:Track ;
    rdfs:label "Farmer's Daughter"@en ;
    ex:hasChartRun ex:chartRun_run_farmers_daughter_rodney_atkins_b64f66_2010-11-06 ;
