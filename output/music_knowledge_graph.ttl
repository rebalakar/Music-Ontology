mo:track_a_guy_with_a_girl_blake_shelton_bdfbf3 a mo:Track ;
    rdfs:label "A Guy With A Girl"@en ;
    ex:hasChartRun ex:chartRun_run_a_guy_with_a_girl_blake_shelton_bdfbf3_2017-02-11 ;
