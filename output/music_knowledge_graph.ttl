mo:track_the_sound_of_silence_disturbed_a5a1c8 a mo:Track ;
    rdfs:label "The Sound Of Silence"@en ;
    ex:hasChartRun ex:chartRun_run_the_sound_of_silence_disturbed_a5a1c8_2016-04-23,
        ex:chartRun_run_the_sound_of_silence_disturbed_a5a1c8_2016-06-11 ;
    mo:hasArranger mo:artist_disturbed_1fde13,
        mo:artist_kevin_churko_bbe3ce,
        mo:artist_suzie_katayama_c31005 ;
    mo:hasEngineer mo:artist_kevin_churko_bbe3ce,
        mo:artist_ri_6cecb2,
        mo:artist_ti_68d547 ;
    mo:hasGenre mo:genre_alternative_metal_009cd6,
        mo:genre_ballad_4ed669,
        mo:genre_metal_86094b,
        mo:genre_nu_metal_849888,
        mo:genre_pop_b21afc,
        mo:genre_rock_9a1f30 ;
    mo:hasInstrumentalist mo:artist_dan_97c8e6,
        mo:artist_mike_wengren_e5c0f1 ;
    mo:hasLabel mo:label_reprise_records_7498a6 ;
    mo:hasLanguage mo:language_en ;
    mo:hasLyrics """Hello darkness, my old friend
I've come to talk with you again
Because a vision softly creeping
Left its seeds while I was sleeping
And the vision that was planted in my brain
Still remains within the sound of silence
In restless dreams, I walked alone
Narrow streets of cobblestone
'Neath the halo of a street lamp
I turned my collar to the cold and damp
When my eyes were stabbed by the flash of a neon light
That split the night and touched the sound of silence
And in the naked light, I saw
Ten thousand people, maybe more
People talking without speaking
People hearing without listening
People writing songs that voices never shared
And no one dared disturb the sound of silence
"Fools", said I, "You do not know
Silence like a cancer grows
Hear my words that I might teach you
Take my arms that I might reach you"
But my words like silent raindrops, fell
And echoed in the wells of silence
And the people bowed and prayed
To the neon God they made
And the sign flashed out its warning
In the words that it was forming
And the sign said, "The words of the prophets are written on the subway walls and tenement halls"
And whispered in the sound of silence""" ;
    mo:hasMixer mo:artist_kevin_churko_bbe3ce ;
