mo:track_anything_like_me_brad_paisley_1d2250 a mo:Track ;
    rdfs:label "Anything Like Me"@en ;
    ex:hasChartRun ex:chartRun_run_anything_like_me_brad_paisley_1d2250_2010-12-04 ;
    mo:hasGenre mo:genre_classic_country_9cc7b9,
