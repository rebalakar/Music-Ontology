@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://example.org/time#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

<http://example.org/time#>
    a owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/time#after
time:after rdf:type owl:ObjectProperty ;
           rdfs:domain time:Instant ;
           rdfs:range time:Instant ;
           rdfs:comment "Indicates that one time:Instant occurs after another time:Instant." ;
           rdfs:label "after"@en .


###  http://example.org/time#before
time:before rdf:type owl:ObjectProperty ;
            rdfs:domain time:Instant ;
            rdfs:range time:Instant ;
            rdfs:comment "Indicates that one time:Instant occurs before another time:Instant." ;
            rdfs:label "before"@en .


###  http://example.org/time#hasBeginning
time:hasBeginning rdf:type owl:ObjectProperty ;
                  rdfs:domain time:Interval ;
                  rdfs:range time:Instant ;
                  rdfs:comment "Links a time:Interval to its starting time:Instant." ;
                  rdfs:label "has beginning"@en .


###  http://example.org/time#hasEnd
time:hasEnd rdf:type owl:ObjectProperty ;
            rdfs:domain time:Interval ;
            rdfs:range time:Instant ;
            rdfs:comment "Links a time:Interval to its ending time:Instant." ;
            rdfs:label "has end"@en .


###  http://example.org/time#unitType
time:unitType rdf:type owl:ObjectProperty ;
              rdfs:domain time:Duration ;
              rdfs:range time:TemporalUnit ;
              rdfs:comment "Represents the unit of a duration (e.g., minute, hour)." ;
              rdfs:label "unit type"@en .


#################################################################
#    Data properties
#################################################################

###  http://example.org/time#hasDuration
time:hasDuration rdf:type owl:DatatypeProperty ;
                 rdfs:domain time:Duration ;
                 rdfs:range xsd:duration ;
                 rdfs:comment "Holds the complete duration value for a time:Duration, expressed as an xsd:duration." ;
                 rdfs:label "has duration"@en .


###  http://example.org/time#instantDate
time:instantDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain time:Instant ;
                 rdfs:range xsd:date ;
                 rdfs:comment "Holds the specific date value for a time:Instant, expressed as an xsd:date." ;
                 rdfs:label "instant date"@en .


###  http://example.org/time#numericDuration
time:numericDuration rdf:type owl:DatatypeProperty ;
                     rdfs:domain time:Duration ;
                     rdfs:range xsd:float ;
                     rdfs:comment "Represents the numeric value of a duration (e.g., 2.5)." ;
                     rdfs:label "numeric duration"@en .


#################################################################
#    Classes
#################################################################

###  http://example.org/time#Duration
time:Duration rdf:type owl:Class ;
              rdfs:comment "Represents a duration, such as 5 days or 2 hours." ;
              rdfs:label "Duration"@en .


###  http://example.org/time#Instant
time:Instant rdf:type owl:Class ;
             rdfs:comment "Represents a specific point in time (e.g., 2024-01-01)." ;
             rdfs:label "Instant"@en .


###  http://example.org/time#Interval
time:Interval rdf:type owl:Class ;
              rdfs:comment "Represents a time range (e.g., from January 2024 to December 2024)." ;
              rdfs:label "Interval"@en .


###  http://example.org/time#TemporalUnit
time:TemporalUnit rdf:type owl:Class ;
                  rdfs:comment "Represents a unit of duration (e.g., minute, hour, day as instances)." ;
                  rdfs:label "Temporal Unit"@en .


