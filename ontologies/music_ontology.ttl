###  http://example.org/mo#Arranger
mo:Arranger rdf:type owl:Class ;
          rdfs:comment "Represents a music arranger." ;
          rdfs:label "Arranger"@en ;
          owl:disjointWith mo:Gender, mo:Genre, mo:Label, mo:Language, mo:Track, mo:Record .


###  http://example.org/mo#Engineer
mo:Engineer rdf:type owl:Class ;
            rdfs:comment "Represents a sound engineer who records or mixes tracks." ;
            rdfs:label "Engineer"@en ;
            owl:disjointWith mo:Gender, mo:Genre, mo:Label, mo:Language, mo:Track, mo:Record .


