###  http://example.org/mo#hasArranger
mo:hasArranger rdf:type owl:ObjectProperty ;
               rdfs:domain mo:Track ;
               rdfs:range mo:Arranger ;
               rdfs:comment "Links a track to its arranger(s)." ;
               rdfs:label "has arranger"@en ;
               owl:inverseOf mo:arrangedTrack .


###  http://example.org/mo#arrangedTrack
mo:arrangedTrack rdf:type owl:ObjectProperty ;
                rdfs:domain mo:Arranger ;
                rdfs:range mo:Track ;
                rdfs:comment "Links an arranger to tracks they arranged." ;
                rdfs:label "arranged track"@en ;
                owl:inverseOf mo:hasArranger .


###  http://example.org/mo#hasEngineer
mo:hasEngineer rdf:type owl:ObjectProperty ;
               rdfs:domain mo:Track ;
               rdfs:range mo:Engineer ;
               rdfs:comment "Links a track to its sound engineer." ;
               rdfs:label "Has Engineer"@en ;
               owl:inverseOf mo:engineeredTrack .


###  http://example.org/mo#engineeredTrack
mo:engineeredTrack rdf:type owl:ObjectProperty ;
                  rdfs:domain mo:Engineer ;
                  rdfs:range mo:Track ;
                  rdfs:comment "Links a sound engineer to tracks they engineered." ;
                  rdfs:label "engineered track"@en ;
                  owl:inverseOf mo:hasEngineer .


