PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX fx:   <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:  <http://sparql.xyz/facade-x/data/>
PREFIX ex:   <http://example.org/music/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
    # Define Classes
    ex:Track a rdfs:Class .
    ex:Artist a rdfs:Class .  
    ex:Producer a rdfs:Class .
    ex:Writer a rdfs:Class .
    ex:Editor a rdfs:Class .
    ex:Mixer a rdfs:Class .
    ex:Tag a rdfs:Class .
    ex:Label a rdfs:Class .
    ex:Language a rdfs:Class .
    ex:Gender a rdfs:Class .

    # Define Object Properties
    ex:hasProducer a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Producer .
    ex:hasEditor a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Editor .    
    ex:hasMixer a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Mixer .
    ex:hasTag a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Tag .
    ex:hasArtist a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Artist .
    ex:hasLabel a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Label .
    ex:hasLanguage a rdf:Property ; rdfs:domain ex:Track ; rdfs:range ex:Language .
    ex:hasGender a rdf:Property ; rdfs:domain ex:Artist ; rdfs:range ex:Gender .
    ex:hasLegalName a rdf:Property ; rdfs:domain ex:Artist ; rdfs:range xsd:string .

    # Generate Instances
    ?trackUri a ex:Track ;
        ex:hasProducer ?producerUri ;
        ex:hasEditor ?editorUri ;
        ex:hasMixer ?mixerUri ;
        ex:hasTag ?tagUri ;
        ex:hasArtist ?artistUri ;
        ex:hasLabel ?labelUri ;
        ex:hasLanguage ?languageUri .
    
    ?artistUri a ex:Artist ;
        ex:hasGender ?genderUri ;
        ex:hasLegalName ?legalName .

    ?producerUri a ex:Producer .
    ?editorUri a ex:Editor .
    ?mixerUri a ex:Mixer .
    ?tagUri a ex:Tag .
    ?labelUri a ex:Label .
    ?languageUri a ex:Language .
    ?genderUri a ex:Gender .
}
WHERE {
  SERVICE <x-sparql-anything:> {
    fx:properties fx:location "filtered_alldata.json" .

    ?root xyz:track ?track ;
          xyz:language ?language ;
          xyz:producer ?producerList ;
          xyz:editor ?editorList ;
          xyz:mixer ?mixerList ;
          xyz:tag ?tagList ;
          xyz:label ?labelList ;
          xyz:artist ?artistDict .

    # Extract artistDict
    ?artistDict xyz:artist_name ?artistName ;
                xyz:gender ?gender ;
                xyz:legal_name ?legalNameList .

    # Track and language
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?track, " ", ""))) AS ?trackUri)
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?language, " ", ""))) AS ?languageUri)

    # Producer list
    ?producerList ?pIndex ?producer .
    FILTER(STRSTARTS(STR(?pIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?producer, " ", ""))) AS ?producerUri)

    # Editor list
    ?editorList ?eIndex ?editor .
    FILTER(STRSTARTS(STR(?eIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?editor, " ", ""))) AS ?editorUri)

    # Mixer list
    ?mixerList ?mIndex ?mixer .
    FILTER(STRSTARTS(STR(?mIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?mixer, " ", ""))) AS ?mixerUri)

    # Tag list
    ?tagList ?tIndex ?tag .
    FILTER(STRSTARTS(STR(?tIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?tag, " ", ""))) AS ?tagUri)

    # Label list
    ?labelList ?lIndex ?label .
    FILTER(STRSTARTS(STR(?lIndex), STR(rdf:_)))
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?label, " ", ""))) AS ?labelUri)

    # Artist name and gender
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?artistName, " ", ""))) AS ?artistUri)
    BIND(IRI(CONCAT("http://example.org/music/", REPLACE(?gender, " ", ""))) AS ?genderUri)

    # Legal name list
    ?legalNameList ?lnIndex ?legalName .
    FILTER(STRSTARTS(STR(?lnIndex), STR(rdf:_)))
  }
}